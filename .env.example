# Copia este archivo como .env y completa tus valores.
# El archivo .env nunca se sube al repositorio.

# Proveedor del modelo:
#   grabado      -> usa respuestas guardadas; no llama a ningún servicio y no cuesta nada
#   claude-code  -> usa Claude Code (claude -p) con la sesión de tu plan; sin costo extra si el "uso extra" está desactivado
#   anthropic    -> usa la API de Anthropic con ANTHROPIC_API_KEY; se cobra al dueño de la clave
LLM_PROVEEDOR=grabado

# Modelo para las corridas reales
LLM_MODELO=claude-haiku-5-5

# Solo para LLM_PROVEEDOR=anthropic. Pon aquí TU clave; se cobra a tu cuenta.
ANTHROPIC_API_KEY=

# Emulador de AWS al que apunta OpenTofu (MiniStack o Floci escuchan en el puerto 4566)
AWS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1

# Qué emulador está en AWS_ENDPOINT: floci (contenedor Docker) o ministack (pip, sin Docker).
# Se usa para reiniciar su estado y para nombrar los archivos de resultados.
EMULADOR=floci

# Tope de vueltas del ciclo de retroalimentación
MAX_ITERACIONES=3

# La herramienta se detiene si el costo estimado de una corrida supera este valor (USD)
LIMITE_GASTO_USD=5
