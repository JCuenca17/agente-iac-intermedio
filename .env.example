# Copia este archivo como .env y completa tus valores.
# El archivo .env nunca se sube al repositorio.

# Proveedor del modelo:
#   grabado      -> usa respuestas guardadas; no llama a ningún servicio y no cuesta nada
#   claude-code  -> usa Claude Code (claude -p) con la sesión de tu plan; sin costo extra si el "uso extra" está desactivado
#   anthropic    -> usa la API de Anthropic con ANTHROPIC_API_KEY; se cobra al dueño de la clave
#   openai-compatible -> cualquier API con el formato de OpenAI (OpenRouter, NVIDIA, Groq, Ollama local);
#                    se cobra al dueño de LLM_API_KEY. Ver el bloque de abajo.
LLM_PROVEEDOR=grabado

# Modelo para las corridas reales
LLM_MODELO=claude-haiku-5-5

# Solo para LLM_PROVEEDOR=anthropic. Pon aquí TU clave; se cobra a tu cuenta.
ANTHROPIC_API_KEY=

# Solo para LLM_PROVEEDOR=openai-compatible. LLM_MODELO es el nombre del modelo en ese proveedor.
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1          (modelos ":free" sin costo, con límite de solicitudes)
#   NVIDIA:     LLM_BASE_URL=https://integrate.api.nvidia.com/v1    (créditos de prueba en build.nvidia.com)
#   Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1
#   Ollama:     LLM_BASE_URL=http://localhost:11434/v1              (local, sin clave ni costo)
LLM_BASE_URL=
LLM_API_KEY=
# Precio por millón de tokens del modelo (de la página del proveedor), para medir el costo y
# aplicar los límites de gasto. Pon 0 y 0 si el modelo es gratuito. No hace falta para los
# modelos de Claude que ya están en precios.json.
LLM_PRECIO_ENTRADA_MTOK=
LLM_PRECIO_SALIDA_MTOK=

# Emulador de AWS al que apunta OpenTofu (MiniStack o Floci escuchan en el puerto 4566)
AWS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1

# Qué emulador está en AWS_ENDPOINT: floci (contenedor Docker) o ministack (pip, sin Docker).
# Se usa para reiniciar su estado y para nombrar los archivos de resultados.
EMULADOR=floci

# Tope de vueltas del ciclo de retroalimentación
MAX_ITERACIONES=3

# Segundos que puede tardar un comando de OpenTofu antes de cortarlo (si el emulador se cuelga)
TOFU_TIEMPO_LIMITE_S=1200

# La herramienta se detiene si el costo estimado de una corrida supera este valor (USD)
LIMITE_GASTO_USD=5

# El experimento completo se detiene antes de una corrida si el gasto acumulado llega a este valor (USD)
LIMITE_GASTO_EXPERIMENTO_USD=10

# Nombre del contenedor de Floci (docker run --name ...), para reiniciarlo si una corrida deja recursos
FLOCI_CONTENEDOR=floci
