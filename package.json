{
  "name": "agente-iac-intermedio",
  "version": "0.1.0",
  "description": "Agente LLM que genera un artefacto intermedio de infraestructura, lo valida por capas y lo despliega con OpenTofu en un emulador de AWS",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && opa test politicas",
    "doctor": "node scripts/doctor.mjs",
    "prueba-minima": "node scripts/prueba-minima.mjs",
    "esquema-proveedor": "node scripts/esquema-proveedor.mjs",
    "test:integracion": "vitest run --config vitest.integracion.config.ts",
    "preagente": "tsc",
    "agente": "node dist/src/cli.js",
    "preexperimento": "tsc",
    "experimento": "node dist/src/experimento/cli.js",
    "preresumen": "tsc",
    "resumen": "node dist/src/experimento/resumen-cli.js"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "ajv": "^8.20.0"
  },
  "bin": {
    "agente-iac": "dist/src/cli.js"
  }
}
